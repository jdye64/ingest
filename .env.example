# Copy to .env and adjust as needed
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/ingest.db
# DATABASE_URL=postgresql+asyncpg://ingest:ingest@127.0.0.1:5432/ingest
LANCEDB_PATH=./data/lancedb
WATCH_PATHS=./watch_sample
WORKER_CONCURRENCY=2
RECONCILE_INTERVAL_SECONDS=60
EMBEDDER_PROVIDER=deterministic
EMBEDDER_MODEL=hash-384
EMBEDDER_DIMENSION=384
# EMBEDDER_PROVIDER=local
# EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDER_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=100
INGESTOR_HEARTBEAT_TIMEOUT_SECONDS=15
INGESTOR_HEARTBEAT_INTERVAL_SECONDS=5
INGESTOR_SOURCE_SYNC_SECONDS=10
INGESTOR_CLAIM_TIMEOUT_SECONDS=600
